PORT=3000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=schulden_db
DB_PORT=3306
JWT_SECRET=change-me-to-a-long-random-string

# Pfad zur Aiven CA-Zertifikatsdatei für verifizierte TLS-Verbindung zur Datenbank.
# Datei vom Aiven-Dashboard herunterladen: Service → Quick Connect → CA Certificate.
# Ohne diesen Eintrag läuft der Server mit rejectUnauthorized=false (nur lokale Entwicklung).
# Beispiel: DB_SSL_CA_PATH=./aiven-ca.pem
DB_SSL_CA_PATH=
